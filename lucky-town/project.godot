; Engine configuration file for the "Lucky Town" life-simulation game.
; Godot Engine 4.x  --  https://godotengine.org
;
; This file is the single source of truth for engine-level configuration:
; autoload singletons, the input map, rendering settings and feature flags.
; Game *content* lives in the data-driven JSON / Resource files under res://data
; so that designers can extend the game without touching engine config.

config_version=5

[application]

config/name="Lucky Town"
config/description="Offline-first 3D life-simulation game. Slots are one activity inside a living, AI-driven city."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"
config/version="0.1.0"

[autoload]

; Order matters: each singleton may depend on the ones declared above it.
Log="*res://src/autoload/log.gd"
EventBus="*res://src/autoload/event_bus.gd"
RngService="*res://src/autoload/rng_service.gd"
DataRegistry="*res://src/autoload/data_registry.gd"
GameClock="*res://src/autoload/game_clock.gd"
Economy="*res://src/autoload/economy.gd"
SaveManager="*res://src/autoload/save_manager.gd"
GameState="*res://src/autoload/game_state.gd"
QuestSystem="*res://src/autoload/quest_system.gd"
AuctionHouse="*res://src/autoload/auction_house.gd"
AchievementSystem="*res://src/autoload/achievement_system.gd"
TitleSystem="*res://src/autoload/title_system.gd"
WorldDirector="*res://src/autoload/world_director.gd"
NetSync="*res://src/autoload/net_sync.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

