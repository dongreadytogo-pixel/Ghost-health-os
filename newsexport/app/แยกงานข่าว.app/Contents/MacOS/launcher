# ------------------------------------------------------------
# เปิดหน้าจอหลัก
# ------------------------------------------------------------
# ส่งตำแหน่งโฟลเดอร์ Resources ไปให้ เพื่อให้หาไฟล์ตัวช่วยเจอ
#
# ห้ามใช้ exec ตรง ๆ อีกแล้ว
# ถ้าหน้าจอหลักมีปัญหา ข้อความผิดพลาดจะหายไปกับ Terminal ที่ไม่มีใครเห็น
# ผู้ใช้จะเห็นแค่ว่า กดแล้วไม่มีอะไรขึ้นมา ซึ่งหาสาเหตุไม่ได้เลย
#
# จึงต้องรับข้อความผิดพลาดไว้ แล้วเอามาแสดงให้เห็นเสมอ
ERRLOG="$HOME/Library/Caches/fcpx-news-export/ข้อผิดพลาดตอนเปิด.txt"
mkdir -p "$(dirname "$ERRLOG")"

if ! /usr/bin/osascript "$RESOURCES/main.applescript" "$RESOURCES" 2>"$ERRLOG"; then
