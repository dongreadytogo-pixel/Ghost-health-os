#!/bin/bash
# ============================================================
# ตัวเริ่มโปรแกรม
# ------------------------------------------------------------
# ไฟล์นี้คือสิ่งที่ macOS เรียกเมื่อผู้ใช้ดับเบิลคลิกที่ตัวโปรแกรม
# หน้าที่มีอย่างเดียวคือ หาตำแหน่งไฟล์ต่าง ๆ แล้วส่งต่อให้หน้าจอหลัก
# ผู้ใช้จะไม่เห็น Terminal เลย เพราะทุกอย่างแสดงเป็นหน้าต่างของ Mac
# ============================================================

set -u

# หาตำแหน่งโฟลเดอร์ Resources ที่อยู่ในตัวโปรแกรม
HERE="$(cd "$(dirname "$0")" && pwd)"
RESOURCES="$(cd "$HERE/../Resources" && pwd)"

# ------------------------------------------------------------
# ตรวจว่าเครื่องมีตัวช่วยที่จำเป็นครบไหม
# ------------------------------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
    osascript -e 'display dialog "เครื่องนี้ยังไม่มีตัวช่วยที่จำเป็น

วิธีแก้ ทำครั้งเดียวจบ
1. เปิดโปรแกรม Terminal
2. พิมพ์คำสั่งนี้แล้วกด Enter

    xcode-select --install

3. กดปุ่ม Install ในหน้าต่างที่เด้งขึ้นมา
   เป็นของฟรีจาก Apple

เสร็จแล้วเปิดโปรแกรมนี้ใหม่อีกครั้ง" buttons {"ปิด"} default button 1 with title "แยกงานข่าว" with icon caution'
    exit 1
fi

# ------------------------------------------------------------
# เปิดหน้าจอหลัก
# ------------------------------------------------------------
# ส่งตำแหน่งโฟลเดอร์ Resources ไปให้ เพื่อให้หาไฟล์ตัวช่วยเจอ
exec /usr/bin/osascript "$RESOURCES/main.applescript" "$RESOURCES"
