#!/bin/bash
# ============================================================
# หน้าต่างแสดงความคืบหน้า
# ------------------------------------------------------------
# ไฟล์นี้เปิดขึ้นมาเป็นหน้าต่างหนึ่งบาน แล้ววาดหน้าจอใหม่ทุกวินาที
#
# ทำไมต้องวาดใหม่ทั้งหน้า ไม่ใช่ไล่พิมพ์ต่อกันไปเรื่อย ๆ
# รุ่นก่อนพิมพ์ต่อกันไปเรื่อย ๆ พอทำงานนานเข้า ข้อความยาวเป็นร้อยบรรทัด
# ผู้ใช้ต้องเลื่อนหาเองว่าตอนนี้ถึงไหนแล้ว ซึ่งอ่านยากมาก
#
# รุ่นนี้แบ่งหน้าจอเป็นสามส่วน และวาดใหม่ทั้งหน้าทุกวินาที
#   ส่วนบน    ขั้นตอนที่กำลังทำอยู่
#   ส่วนกลาง  แถบความคืบหน้า และคำอธิบายว่าเกิดอะไรขึ้น
#   ส่วนล่าง  รายละเอียดล่าสุดสิบสองบรรทัด
#
# ตำแหน่งของแต่ละส่วนอยู่ที่เดิมเสมอ ตาจึงไม่ต้องไล่หา
#
# หมายเหตุสำหรับผู้ดูแลโค้ด
# ชื่อตัวแปรในไฟล์นี้ต้องเป็นภาษาอังกฤษเท่านั้น
# bash ไม่รองรับชื่อตัวแปรภาษาไทย ถ้าใช้จะกลายเป็นคำสั่งที่ไม่มีอยู่จริง
# ============================================================

WORK="$HOME/Library/Caches/fcpx-news-export"
LOG="$WORK/กำลังทำงาน.txt"
BOARD="$WORK/สรุปสด.txt"

RULE="────────────────────────────────────────────────────────────"

# ขยายหน้าต่างให้พอดีกับที่ออกแบบไว้ และตั้งชื่อหน้าต่าง
printf '\033[8;30;72t'
printf '\033]0;แยกงานข่าว\007'

# รอไฟล์บันทึกโผล่ก่อน เผื่อหน้าต่างนี้เปิดมาไวกว่าที่โปรแกรมจะเขียน
for _ in $(seq 1 20); do
    [ -f "$LOG" ] && break
    sleep 1
done

while true; do
    STEP="$(sed -n '1p' "$BOARD" 2>/dev/null)"
    BAR="$(sed -n '2p' "$BOARD" 2>/dev/null)"
    SITUATION="$(sed -n '3p' "$BOARD" 2>/dev/null)"
    [ -z "$STEP" ] && STEP="กำลังเริ่ม"

    clear
    printf '\n   แยกงานข่าว\n'
    printf '   %s\n\n' "$RULE"
    printf '   กำลังทำ\n'
    printf '     %s\n\n' "$STEP"
    [ -n "$BAR" ] && printf '     %s\n' "$BAR"
    [ -n "$SITUATION" ] && printf '     %s\n' "$SITUATION"
    printf '\n   %s\n' "$RULE"
    printf '   รายละเอียดล่าสุด\n\n'
    # ตัดเครื่องหมายจบออก เป็นของภายในโปรแกรม ผู้ใช้ไม่ต้องเห็น
    grep -v '@@จบ@@' "$LOG" 2>/dev/null | tail -n 12 | sed 's/^/     /'

    grep -q '@@จบ@@' "$LOG" 2>/dev/null && break
    sleep 1
done

printf '\n   %s\n' "$RULE"
printf '   จบแล้ว ปิดหน้าต่างนี้ได้เลย\n'
printf '   ถ้าอยากส่งให้ผู้พัฒนาดู ให้เลือกข้อความทั้งหมดแล้วคัดลอก\n\n'
