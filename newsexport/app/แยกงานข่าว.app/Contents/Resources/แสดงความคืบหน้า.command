#!/bin/bash
# ============================================================
# หน้าต่างแสดงความคืบหน้า
# ------------------------------------------------------------
# ไฟล์นี้เปิดขึ้นมาเป็นหน้าต่างข้อความหนึ่งบาน
# แล้วคอยอ่านไฟล์บันทึกของรอบที่กำลังทำงานอยู่ ซ้ำทุกวินาที
# ผู้ใช้จึงเห็นตลอดเวลาว่าโปรแกรมกำลังทำอะไร คล้ายหน้าต่างโปรแกรมดาวน์โหลด
#
# ทำไมเป็นไฟล์สำเร็จรูป ไม่ให้โปรแกรมสร้างเอาเองตอนใช้งาน
# รุ่นก่อนสร้างไฟล์นี้ขึ้นมาสด ๆ ด้วยคำสั่งเขียนไฟล์ของ AppleScript
# ซึ่งเป็นส่วนที่เปราะและทดสอบล่วงหน้าไม่ได้
# ทำเป็นไฟล์สำเร็จรูปแล้วทดสอบไว้ก่อน ปลอดภัยกว่ามาก
#
# จบเองเมื่อเห็นเครื่องหมายจบในไฟล์บันทึก จึงไม่ค้างทิ้งไว้
# ============================================================

LOG="$HOME/Library/Caches/fcpx-news-export/กำลังทำงาน.txt"

# รอไฟล์บันทึกโผล่ก่อน เผื่อหน้าต่างนี้เปิดมาไวกว่าที่โปรแกรมจะเขียน
for _ in $(seq 1 20); do
    [ -f "$LOG" ] && break
    sleep 1
done

while true; do
    clear
    cat "$LOG" 2>/dev/null
    if grep -q '@@จบ@@' "$LOG" 2>/dev/null; then
        break
    fi
    sleep 1
done

echo
echo "จบแล้ว ปิดหน้าต่างนี้ได้เลย"
