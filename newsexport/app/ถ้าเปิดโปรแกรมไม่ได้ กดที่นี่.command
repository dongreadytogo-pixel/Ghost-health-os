#!/bin/bash
# ============================================================
# ตัวช่วยแก้ปัญหา "เปิดโปรแกรมไม่ได้"
# ------------------------------------------------------------
# macOS จะติดป้ายกันไว้กับไฟล์ที่ดาวน์โหลดมาจากอินเทอร์เน็ต
# ไฟล์นี้ทำหน้าที่เดียวคือ ลอกป้ายนั้นออกจากตัวโปรแกรม
# ไม่ได้ปิดระบบความปลอดภัยของเครื่อง และไม่แตะไฟล์อื่นเลย
# ============================================================
cd "$(dirname "$0")" || exit 1

APP="แยกงานข่าว.app"

echo "============================================"
echo "  ตัวช่วยแก้ปัญหาเปิดโปรแกรมไม่ได้"
echo "============================================"
echo

if [ ! -d "$APP" ]; then
    echo "  ไม่พบตัวโปรแกรมในโฟลเดอร์นี้"
    echo "  ให้วางไฟล์นี้ไว้ที่เดียวกับ $APP"
    echo
    read -r -p "  กด Enter เพื่อปิด "
    exit 1
fi

echo "  กำลังลอกป้ายกันของ macOS ออก…"
xattr -cr "$APP" 2>/dev/null
chmod +x "$APP/Contents/MacOS/launcher" 2>/dev/null

echo "  เรียบร้อย"
echo
echo "  ลองดับเบิลคลิกที่ $APP อีกครั้งได้เลย"
echo
echo "  ถ้ายังเปิดไม่ได้ ให้ไปที่"
echo "     เมนู Apple > System Settings > Privacy & Security"
echo "     เลื่อนลงไปล่างสุด จะเห็นข้อความเกี่ยวกับโปรแกรมนี้"
echo "     กดปุ่ม Open Anyway"
echo
read -r -p "  กด Enter เพื่อปิด "
