#!/bin/bash
# ============================================================
# ตัวแยกงานข่าว — สำหรับดับเบิลคลิกใช้งาน
# ------------------------------------------------------------
# ไฟล์นี้ทำให้ใช้โปรแกรมได้โดยไม่ต้องพิมพ์คำสั่งใด ๆ
# แค่ดับเบิลคลิก แล้วลากไฟล์งานมาวาง
# ============================================================

# ย้ายไปโฟลเดอร์ที่ไฟล์นี้อยู่ เพื่อให้หาโปรแกรมเจอเสมอ
cd "$(dirname "$0")" || exit 1

# ตัวอักษรสีสำหรับให้อ่านง่ายขึ้น
BOLD=$'\033[1m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
OFF=$'\033[0m'

clear
echo "${BOLD}============================================================${OFF}"
echo "${BOLD}   ตัวแยกงานข่าว จาก Final Cut Pro${OFF}"
echo "${BOLD}============================================================${OFF}"
echo
echo "  โปรแกรมนี้จะแยกไทม์ไลน์ยาว ๆ ออกเป็นงานย่อยทีละก้อน"
echo "  แล้วตั้งชื่อให้ถูกต้องไว้ให้เรียบร้อย"
echo

# ------------------------------------------------------------
# ขั้นที่ 1 ตรวจว่าเครื่องพร้อมใช้งานไหม
# ------------------------------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
    echo "${RED}  ไม่พบตัวช่วยที่จำเป็น (python3)${OFF}"
    echo
    echo "  วิธีแก้: พิมพ์คำสั่งข้างล่างนี้ใน Terminal แล้วกด Enter"
    echo "  แล้วกดปุ่ม Install ในหน้าต่างที่เด้งขึ้นมา (ของ Apple ฟรี)"
    echo
    echo "      xcode-select --install"
    echo
    read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
    exit 1
fi

# ------------------------------------------------------------
# ขั้นที่ 2 รับไฟล์จากผู้ใช้
# ------------------------------------------------------------
echo "${BOLD}  ขั้นที่ 1${OFF}  ลากไฟล์ .fcpxml มาวางในหน้าต่างนี้ แล้วกด Enter"
echo
echo "  ${YELLOW}(ยังไม่มีไฟล์? เปิด Final Cut Pro > คลิกที่ชื่องาน${OFF}"
echo "  ${YELLOW} > เมนู File > Export XML… > เซฟไว้ที่ Desktop)${OFF}"
echo
printf "  ไฟล์: "
read -r RAW_PATH

# เวลาลากไฟล์มาวาง macOS จะใส่เครื่องหมายคำพูดและ \ มาให้ ต้องเอาออกก่อน
INPUT_PATH="${RAW_PATH%\"}"
INPUT_PATH="${INPUT_PATH#\"}"
INPUT_PATH="${INPUT_PATH%\'}"
INPUT_PATH="${INPUT_PATH#\'}"
INPUT_PATH="$(printf '%s' "$INPUT_PATH" | sed 's/\\ / /g')"
# ตัดช่องว่างหัวท้ายทิ้ง
INPUT_PATH="$(printf '%s' "$INPUT_PATH" | sed 's/^ *//; s/ *$//')"

if [ -z "$INPUT_PATH" ]; then
    echo
    echo "${RED}  ยังไม่ได้ใส่ไฟล์${OFF}"
    read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
    exit 1
fi

if [ ! -f "$INPUT_PATH" ]; then
    echo
    echo "${RED}  หาไฟล์นี้ไม่เจอ:${OFF} $INPUT_PATH"
    echo "  ลองใหม่โดยการลากไฟล์มาวาง อย่าพิมพ์เอง"
    read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
    exit 1
fi

# ------------------------------------------------------------
# ขั้นที่ 3 ถามเรื่องช่องว่างที่ใช้คั่นข่าว
# ------------------------------------------------------------
echo
echo "${BOLD}  ขั้นที่ 2${OFF}  ช่องว่างกี่วินาที ถึงจะนับว่าคั่นข่าวคนละเรื่อง"
echo
echo "  กด Enter เฉย ๆ เพื่อใช้ค่าปกติคือ 1 วินาที"
echo "  ${YELLOW}(ถ้าผลออกมาได้ก้อนน้อยเกินไป ให้ลองใส่ 0.5${OFF}"
echo "  ${YELLOW} ถ้าได้ก้อนเยอะเกินไป ให้ลองใส่ 2 หรือ 3)${OFF}"
echo
printf "  วินาที [1]: "
read -r MIN_GAP
[ -z "$MIN_GAP" ] && MIN_GAP=1

# ------------------------------------------------------------
# ขั้นที่ 4 ดูรายการก่อน ว่าแยกได้กี่ก้อน
# ------------------------------------------------------------
echo
echo "${BOLD}  กำลังอ่านไทม์ไลน์…${OFF}"
if ! python3 tools/fcpxml_segments.py "$INPUT_PATH" --min-gap "$MIN_GAP"; then
    echo
    read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
    exit 1
fi

# ------------------------------------------------------------
# ขั้นที่ 5 ยืนยันก่อนสร้างไฟล์จริง
# ------------------------------------------------------------
echo "${BOLD}  ขั้นที่ 3${OFF}  รายการข้างบนถูกต้องไหม"
echo
printf "  พิมพ์ y แล้วกด Enter เพื่อสร้างไฟล์  (หรือกด Enter เฉย ๆ เพื่อยกเลิก): "
read -r CONFIRM

if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
    echo
    echo "  ยกเลิกแล้ว ไม่มีไฟล์ไหนถูกสร้างหรือแก้ไข"
    echo "  ${YELLOW}ถ้าจำนวนก้อนไม่ถูก ให้เปิดโปรแกรมใหม่แล้วลองเปลี่ยนตัวเลขวินาทีดู${OFF}"
    echo
    read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
    exit 0
fi

# เก็บผลลัพธ์ไว้ข้าง ๆ ไฟล์ต้นฉบับ จะได้หาเจอง่าย
OUTPUT_PATH="${INPUT_PATH%.fcpxml}-แยกแล้ว.fcpxml"

echo
if python3 tools/fcpxml_split.py "$INPUT_PATH" -o "$OUTPUT_PATH" --min-gap "$MIN_GAP"; then
    echo "${GREEN}${BOLD}  เสร็จเรียบร้อย${OFF}"
    echo
    # เปิด Finder ให้เห็นไฟล์ผลลัพธ์เลย จะได้ไม่ต้องไปตามหา
    open -R "$OUTPUT_PATH" 2>/dev/null
else
    echo
    echo "${RED}  ทำไม่สำเร็จ กรุณาถ่ายรูปหน้าจอนี้ส่งกลับมา${OFF}"
fi

echo
read -r -p "  กด Enter เพื่อปิดหน้าต่าง "
